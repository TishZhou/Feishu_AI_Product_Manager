# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-5.5

# Volcano Engine (ByteDance) — OpenAI-compatible
# api_key format is "AK:SK" — your Access Key and Secret Key joined by a colon
VOLCANO_API_KEY= key_id:secret_key
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/compatible/v1
VOLCANO_DEFAULT_MODEL=seed-v1.6

# App
DEFAULT_PROVIDER=openai
ARTIFACTS_DIR=artifacts
DATABASE_URL=sqlite+aiosqlite:///data/devflow.db
